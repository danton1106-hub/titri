# Единый образец окружения для «Титров».
# Скопируйте этот файл в .env и заполните значения.
# Файлы .env и .env.local в репозиторий не попадают (см. .gitignore).
#
#   cp .env.example .env
#
# Порядок чтения: реальные переменные окружения → .env → .env.local.
# GitHub Actions берёт значения из GitHub Secrets с теми же именами.

# --- TMDB ---
# Ключ доступа TMDB API (Settings → API → API Read Access Token).
# Нужен для обновления каталога: data/catalog.json и data/home.json.
# Без ключа сборка сайта работает, но данные остаются прежними.
TMDB_API_READ_TOKEN=

# --- Внешние рейтинги (необязательно) ---
# Ключ OMDb: IMDb, Rotten Tomatoes, Metacritic. Бесплатный тариф — 1000 запросов в сутки.
OMDB_API_KEY=

# --- Режим сборки без ключа ---
# 1 — собирать сайт из уже сохранённых данных, когда ключей нет.
# 0 или пусто — завершаться понятной ошибкой, если ключ обязателен.
TITRI_ALLOW_CACHED_DATA=

# --- Время ---
# Бизнес-часовой пояс проекта. «Сегодня» и «на этой неделе» считаются по нему.
TITRI_TIMEZONE=Europe/Moscow
