# Публичный демонстрационный ключ TMDB.
# Работает без регистрации, но может отвалиться в любой момент и имеет общие лимиты.
# Свой ключ получишь бесплатно: themoviedb.org → Settings → API
TMDB_API_KEY=8265bd1679663a7ea12ac168da84d2e8

# Регион для данных о площадках показа (JustWatch через TMDB)
NEXT_PUBLIC_REGION=RU

# Ключ OMDb — бесплатный, даёт рейтинги IMDb, Rotten Tomatoes (критики) и Метакритик.
# Получить: omdbapi.com/apikey.aspx  (тариф Free, ~1000 запросов в сутки)
OMDB_API_KEY=
